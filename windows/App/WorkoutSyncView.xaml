<UserControl x:Class="App.WorkoutSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14,12,14,16" Spacing="10">
      <Button Click="Back_Click" AutomationProperties.Name="Back to timer">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE72B;" FontSize="14"/>
          <TextBlock Text="Timer"/>
        </StackPanel>
      </Button>
      <TextBlock Text="Workout sync" Style="{ThemeResource TitleTextBlockStyle}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="10">
          <TextBlock Text="Receiver connection" Style="{StaticResource CardTitle}"/>
          <TextBox x:Name="ReceiverUrl" Header="Receiver URL" PlaceholderText="https://workouts.araoz.dev"
                   MaxLength="512" TextChanged="UrlChanged" IsSpellCheckEnabled="False"/>
          <PasswordBox x:Name="ReceiverToken" Header="Bearer token" PlaceholderText="Enter the receiver token"
                       MaxLength="512" PasswordRevealMode="Hidden" PasswordChanged="TokenChanged"/>
          <Button x:Name="SaveButton" Content="Save settings" IsEnabled="False" Click="Save_Click"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="8">
          <TextBlock Text="Sync status" Style="{StaticResource CardTitle}"/>
          <TextBlock x:Name="LastSuccess" Text="Last successful sync · —" TextWrapping="Wrap"/>
          <TextBlock x:Name="EarnedCredit" Text="Dota credit earned this week · —" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="SyncButton" Content="Sync now" Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False" Click="Sync_Click"/>
            <ProgressRing x:Name="SyncProgress" Width="22" Height="22" IsActive="False" Visibility="Collapsed"/>
          </StackPanel>
          <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
