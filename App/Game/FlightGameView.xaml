<UserControl x:Class="App.Game.FlightGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:App.Game"
             FontFamily="Segoe UI" Foreground="#EEF3FF" Background="#101726">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Muted" Color="#98A8C3" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EEFA" />
            <Setter Property="Background" Value="#25324A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.65" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#F8CD73" />
                                <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F1F5FF" />
            <Setter Property="Background" Value="#182337" />
            <Setter Property="BorderBrush" Value="#3A4B68" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#536FA5" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="#2A3750" BorderThickness="1" CornerRadius="10" Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="28" />
                <RowDefinition Height="186" />
                <RowDefinition Height="59" />
                <RowDefinition Height="35" />
                <RowDefinition Height="44" />
                <RowDefinition Height="32" />
                <RowDefinition Height="44" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M 0,10 L 8,7 L 4,0 L 9,0 L 15,6 L 24,4 L 27,6 L 16,11 L 10,19 L 6,19 L 9,12 L 2,14 Z"
                      Fill="#FF5C74" Width="27" Height="20" Margin="0,0,8,0" />
                <TextBlock Text="FLIGHT CLUB" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
            <Border Background="#293047" CornerRadius="12" HorizontalAlignment="Right" Padding="10,4" VerticalAlignment="Center">
                <TextBlock x:Name="BalanceText" Foreground="#F8CD73" FontSize="12" FontWeight="SemiBold"
                           AutomationProperties.Name="Coin balance" />
            </Border>
            <StackPanel x:Name="HistoryPanel" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" />
            <Border Grid.Row="2" CornerRadius="8" ClipToBounds="True" Background="#0B1223">
                <Grid ClipToBounds="True">
                    <local:FlightScene x:Name="Scene" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0" IsHitTestVisible="False">
                        <TextBlock x:Name="PhaseText" FontSize="10" FontWeight="SemiBold" Foreground="#AEC1E3"
                                   HorizontalAlignment="Center" Text="BOARDING OPEN · TAKEOFF IN" />
                        <TextBlock x:Name="MultiplierText" Text="5s" FontSize="38" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="OutcomeText" FontSize="11" Foreground="#AEC1E3" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <TextBlock Text="SPACE TO CASH OUT" FontSize="8" Foreground="#7389AD"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Grid Grid.Row="3" Margin="0,8,0,0" x:Name="BetControls">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="BET · COINS" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,0,0,3" />
                    <TextBox x:Name="BetInput" Text="10" MaxLength="16" AutomationProperties.Name="Bet in coins" />
                </StackPanel>
                <Button Grid.Column="1" Content="−" Click="DecreaseBet" Margin="0,15,4,0" Padding="9,4" AutomationProperties.Name="Halve bet" />
                <Button Grid.Column="2" Content="+" Click="IncreaseBet" Margin="0,15,8,0" Padding="9,4" AutomationProperties.Name="Double bet" />
                <Button Grid.Column="3" Content="10" Click="PresetBet" Tag="10" Margin="0,15,4,0" Padding="8,4" AutomationProperties.Name="Bet 10 coins" />
                <Button Grid.Column="4" Content="25" Click="PresetBet" Tag="25" Margin="0,15,0,0" Padding="8,4" AutomationProperties.Name="Bet 25 coins" />
            </Grid>
            <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" x:Name="AutoControls">
                <CheckBox x:Name="AutoCheck" Content="Auto cash-out" Foreground="{StaticResource Muted}"
                          FontSize="11" VerticalAlignment="Center" Checked="AutoChanged" Unchecked="AutoChanged" />
                <TextBox x:Name="AutoInput" Width="59" Text="2.00" Margin="10,0,4,0" FontSize="12" Padding="5,2"
                         IsEnabled="False" MaxLength="6" AutomationProperties.Name="Auto cash-out multiplier" />
                <TextBlock Text="×" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Row="5" x:Name="ActionButton" Content="BOARD THIS FLIGHT" FontWeight="Bold" FontSize="13"
                    Background="#EF4C68" Click="ActionClick" Margin="0,3,0,3" Typography.NumeralAlignment="Tabular" />
            <TextBlock Grid.Row="6" x:Name="MessageText" FontSize="10" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <Grid Grid.Row="7" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SellCoinsButton" Content="SELL 1 COIN · +1m" FontSize="11" Margin="0,0,4,0"
                        Click="SellCoinsClick" IsEnabled="False" AutomationProperties.Name="Sell 1 coin for 1 minute today"
                        ToolTip="Sell 1 available coin to add 1 minute to today's Steam budget." />
                <Button Grid.Column="1" x:Name="BuyCoinsButton" Content="BUY 10 COINS · −11m" FontSize="11" Margin="4,0,0,0"
                        Click="BuyCoinsClick" IsEnabled="False" AutomationProperties.Name="Buy 10 coins for 11 minutes today"
                        ToolTip="Spend 11 minutes of today's remaining Steam budget to buy 10 coins." />
            </Grid>
            <TextBlock Grid.Row="8" x:Name="ExchangeMessageText" FontSize="10" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
