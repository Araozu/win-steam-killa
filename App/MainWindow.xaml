<Window x:Class="App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:App"
        Title="Steam Timer">
  <Grid x:Name="WindowLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="Steam Timer"/>
    <ScrollViewer x:Name="Root" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="10,10,10,12">
        <Button Content="Workout sync" HorizontalAlignment="Right" Margin="0,0,0,6" Click="WorkoutSync_Click"/>
        <!-- Remaining -->
        <Grid Margin="2,0,2,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Remaining:" FontSize="28" VerticalAlignment="Center"/>
          <TextBlock x:Name="RemainingTime" Grid.Column="1" FontFamily="Consolas" FontSize="38" FontWeight="Bold" VerticalAlignment="Center">
            <Run x:Name="RemH" Text="–"/><Run Text="h" FontSize="20" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Run x:Name="RemM" Text="–"/><Run Text="m" FontSize="20" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Run x:Name="RemS" Text="–"/><Run Text="s" FontSize="20" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </TextBlock>
          <TextBlock x:Name="UnavailableTime" Grid.Column="1" FontSize="32" FontWeight="Bold"
                     Foreground="#D92F20" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <TextBlock x:Name="StatusText" Text="Waiting for the service…" TextWrapping="Wrap" Margin="2,4,2,0"/>

        <TextBlock Text="Limits:" Style="{StaticResource SectionTitle}"/>

        <!-- Time of day -->
        <Border Style="{StaticResource Card}" Margin="0,6,0,0">
          <StackPanel>
            <TextBlock Text="Time of day" Style="{StaticResource CardTitle}"/>
            <Grid x:Name="TodTrack" Height="12">
              <Border Background="{ThemeResource TrackBrush}" CornerRadius="6"/>
              <Border x:Name="TodFill" CornerRadius="6" Background="{ThemeResource TimeFillBrush}" HorizontalAlignment="Left" Width="0"/>
              <Border x:Name="TodClosedTrack" CornerRadius="6" Visibility="Collapsed"/>
            </Grid>
            <Grid Margin="0,3,0,0">
              <TextBlock x:Name="TodStart" Text="—" Style="{StaticResource ScaleLabel}" HorizontalAlignment="Left"/>
              <TextBlock x:Name="TodNow" Text="—" Style="{StaticResource ScaleLabel}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="TodEnd" Text="—" Style="{StaticResource ScaleLabel}" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Session -->
        <Border Style="{StaticResource Card}" Margin="0,6,0,0">
          <StackPanel>
            <TextBlock Text="Session length" Style="{StaticResource CardTitle}"/>
            <Border x:Name="SessTrack" Height="12" Background="{ThemeResource TrackBrush}" CornerRadius="6">
              <Border x:Name="SessFill" Height="12" CornerRadius="6" Background="#7145B8" HorizontalAlignment="Left" Width="0"/>
            </Border>
            <Grid Margin="0,3,0,0">
              <TextBlock x:Name="SessMid" Text="—" Style="{StaticResource ScaleLabel}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="SessMax" Text="2h" Style="{StaticResource ScaleLabel}" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Allowances" Style="{StaticResource SectionTitle}"/>

        <!-- Daily -->
        <Border Style="{StaticResource Card}" Margin="0,6,0,0">
          <StackPanel>
            <TextBlock Text="Daily budget" Style="{StaticResource CardTitle}"/>
            <Border x:Name="DayTrack" Height="12" Background="{ThemeResource TrackBrush}" CornerRadius="6">
              <Border x:Name="DayFill" Height="12" CornerRadius="6" Background="#1FAA53" HorizontalAlignment="Left" Width="0"/>
            </Border>
            <Grid Margin="0,3,0,0">
              <TextBlock x:Name="DayMid" Text="—" Style="{StaticResource ScaleLabel}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="DayMax" Text="—" Style="{StaticResource ScaleLabel}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,4,0,0" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TomorrowText" Text="Tomorrow: —" Opacity="0.7" VerticalAlignment="Center"/>
              <Button x:Name="BorrowDayBtn" Grid.Column="1" Content="Borrow 10m" IsEnabled="False"
                      Padding="10,4" Click="BorrowDay_Click"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Dota -->
        <Border Style="{StaticResource Card}" Margin="0,6,0,0">
          <StackPanel>
            <TextBlock Text="Weekly Dota 2 budget" Style="{StaticResource CardTitle}"/>
            <Border x:Name="DotaTrack" Height="12" Background="{ThemeResource TrackBrush}" CornerRadius="6">
              <Border x:Name="DotaFill" Height="12" CornerRadius="6" Background="#D92D20" HorizontalAlignment="Left" Width="0"/>
            </Border>
            <Grid Margin="0,3,0,0">
              <TextBlock x:Name="DotaMid" Text="—" Style="{StaticResource ScaleLabel}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="DotaMax" Text="—" Style="{StaticResource ScaleLabel}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,4,0,0" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="NextWeekText" Text="Next week: —" Opacity="0.7" VerticalAlignment="Center"/>
              <Button x:Name="BorrowDotaBtn" Grid.Column="1" Content="Borrow 10m" IsEnabled="False"
                      Padding="10,4" Click="BorrowDota_Click"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock x:Name="ActionText" TextWrapping="Wrap" Margin="2,8,2,0" Visibility="Collapsed"/>

        <!-- Old controls, hidden in Details -->
        <Expander Header="Details" Margin="0,6,0,0" IsExpanded="False" Opacity="0.7" FontWeight="SemiBold">
          <Border Style="{StaticResource Card}" Margin="0,6,0,0">
            <StackPanel>
              <TextBlock x:Name="DetectorText" Text="Detector: —" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <StackPanel Spacing="4">
                <Button x:Name="RecheckBtn" Content="Recheck now" Padding="10,5,10,5" Margin="0,0,8,8" Click="Recheck_Click"/>
                <Button x:Name="ForceBtn" Content="Force close Steam + games" Padding="10,5,10,5" Margin="0,0,8,8" Click="Force_Click"/>
                <Button x:Name="ResetBtn" Content="Reset view" Padding="10,5,10,5" Margin="0,0,0,8" Click="Reset_Click"/>
              </StackPanel>
              <TextBlock x:Name="TodayDetail" Text="" FontSize="13" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4"/>
              <TextBlock x:Name="DetectorDetail" Text="" FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <local:WorkoutSyncView x:Name="WorkoutView" Grid.Row="1" Visibility="Collapsed" BackRequested="WorkoutSync_Back"/>
  </Grid>
</Window>
