# Copy to .env.workout on the server (managed manually over SSH):
#   scp this file as /home/docker_admin/steamtimer-develop/.env.workout
#   then edit values on the server. Ansible never writes it.
STRAVA_CLIENT_ID=123456
STRAVA_CLIENT_SECRET=change-me
STRAVA_REDIRECT_URI=https://workouts.araoz.dev/auth/callback
API_TOKEN=change-me-long-random-token
USER_TIMEZONE=America/Santiago
DATA_DIR=/data
POLL_INTERVAL_MINUTES=5
WORKOUT_MULTIPLIER=4
MIN_WORKOUT_SECONDS=600
MAX_DOTA_SECONDS=14400
COUNT_MANUAL=false
