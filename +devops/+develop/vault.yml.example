# Plaintext example - copy to vault.yml then encrypt:
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml   (or: ansible-vault create vault.yml)
# Jenkins passes it via: --extra-vars '@vault.yml' with vaultCredentialsId.
workout_strava_client_id: "123456"
workout_strava_client_secret: "change-me"
workout_strava_redirect_uri: "https://workouts.araoz.dev/auth/callback"
workout_api_token: "change-me-long-random-token"
workout_user_timezone: "America/Santiago"
workout_poll_minutes: "5"
workout_multiplier: "4"
workout_min_seconds: "600"
workout_max_dota: "14400"
workout_count_manual: "false"
